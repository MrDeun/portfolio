---
import '../styles/global.css';

export interface Props {
  title?: string;
}

const { title = "VAULT-TEC TERMINAL" } = Astro.props as Props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="VAULT-TEC PERSONNEL PORTFOLIO — {title}" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="VAULT-TEC PERSONNEL PORTFOLIO TERMINAL" />
    <meta property="og:type" content="website" />
    <title>{title}</title>
  </head>
  <body class="bg-[#0a0e0a] text-[#33ff33] font-mono antialiased">
    <div id="crt-vignette" class="fixed inset-0 z-[9998] pointer-events-none" style="background: radial-gradient(ellipse at center, transparent 55%, rgba(0,0,0,0.7) 100%);"></div>
    <div class="min-h-screen relative z-0">
      <slot />
    </div>
  </body>
</html>
