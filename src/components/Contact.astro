---

<section id="contact" class="px-6 py-28">
  <div class="mx-auto max-w-3xl">
    <p class="mb-2 text-xs tracking-wider text-[#1a7a1a]">$ cat contact.cfg</p>
    <h3 class="mb-8 text-2xl font-display text-glow md:text-3xl">
      CONTACT_CHANNELS
    </h3>

    <div class="border border-[#33ff33]/15 bg-[#0f1a0f] p-6 md:p-8">
      <p class="mb-6 text-sm text-[#33ff33]/70">
        <span class="text-[#1a7a1a]">[STATUS]</span> Open to graduate software engineer
        opportunities. Feel free to reach out.
      </p>

      <div class="mb-6 flex justify-center gap-3">
        {
          socials.map(({ label, href, icon }) => (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              class="flex size-11 items-center justify-center border border-[#33ff33]/20 text-[#33ff33]/60 transition-all duration-200 hover:border-[#33ff33]/40 hover:text-[#33ff33] hover:text-glow-sm"
              aria-label={label}
            >
              <svg class="size-4" fill="currentColor" viewBox="0 0 24 24">
                <path d={icon} />
              </svg>
            </a>
          ))
        }
      </div>

      <div class="border border-[#33ff33]/10 bg-[#0a0e0a] p-5">
        <p class="mb-1 text-xs text-[#1a7a1a]">$ echo $CONTACT_EMAIL</p>
        <a
          href="mailto:pmichalak16@gmail.com"
          class="text-sm text-[#33ff33] transition-all duration-200 hover:text-glow-sm"
          >pmichalak16@gmail.com</a
        >
      </div>
    </div>
  </div>
</section>
